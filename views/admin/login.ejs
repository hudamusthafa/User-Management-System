



<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login</title>
  <link rel="stylesheet" href="/styles/adminlogin.css">
  <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
</head>

<body>

<div class="login-box">
  <h2>Admin Login</h2>
  <p id="formError" style="color:red; text-align:center; margin-bottom:10px;"></p>


  <form action="/admin/login" method="post" id="adminLoginForm">

    <div class="user-box">
      <input type="text" id="email" name="email">
      <label>Email</label>
    </div>

    <div class="user-box">
      <input type="password" id="password" name="password">
      <label>Password</label>
    </div>

    <!-- REPLACE <a> WITH SUBMIT BUTTON -->
    <!--<button type="submit" class="submit-btn">Submit</button>-->
    <button type="submit" class="btn-animate">
    <span></span>
    <span></span>
    <span></span>
    <span></span>
    Submit
</button>

  </form>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.getElementById('adminLoginForm').addEventListener('submit', validateAdminForm);
  });

  const message = "<%= typeof message !== 'undefined' ? message : '' %>";
  const formError = document.getElementById("formError");

  if (message.trim() !== "") {
    formError.textContent = message;
  }

  function validateAdminForm(e) {
    e.preventDefault();

    let email = document.getElementById('email').value.trim();
    let password = document.getElementById('password').value.trim();

    formError.textContent = ""; // clear old error

    if (email === "" || password === "") {
      formError.textContent = "All fields are required";
      return false;
    }

    e.target.submit();
    return true;
  }
</script>


</body>
</html>
