    // 1. Check Email (MANDATORY)
    if (emailInput.value.trim() === "") {
      emailError.textContent = "Email is required";
      valid = false;
    }

    // 2. PASSWORD LOGIC:
    // We only block the submit if BOTH fields are empty.
