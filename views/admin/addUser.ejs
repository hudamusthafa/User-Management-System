<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin | Add New User</title>
  <link rel="stylesheet" href="/styles/adduser.css">

  <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">

  
</head>
<body>

<div class="form-card">
  <h2>Add New User</h2>

  <% if (message) { %>
    <div class="backend-error" id="serverMessage">
      <%= message %>
    </div>
  <% } %>

  <form action="/admin/addUser" method="post" id="addUserForm">
    
    <label for="email">Email Address</label>
    <input type="email" id="email" name="email" placeholder="example@gmail.com">
    <span id="emailError" class="error-text"></span>

    <label for="password">Password</label>
    <input type="password" id="password" name="password" placeholder="••••••••">
    <span id="passwordError" class="error-text"></span>

    <button type="submit" class="btn-save">Save User</button>
  </form>

  <a href="/admin/dashboard" class="back-link">← Back to Dashboard</a>
</div>

<script>
  const form = document.getElementById('addUserForm');
  const emailInput = document.getElementById('email');
  const passwordInput = document.getElementById('password');
  const emailError = document.getElementById('emailError');
  const passwordError = document.getElementById('passwordError');
  const serverMsg = document.getElementById('serverMessage');

  form.addEventListener('submit', function(e) {
    let valid = true;

    // Clear previous frontend errors
    emailError.textContent = "";
    passwordError.textContent = "";
    
    // Hide the "Email already exists" message if the user clicks again
    if(serverMsg) serverMsg.style.display = 'none';

    // 1. Check Email (MANDATORY)
    if (emailInput.value.trim() === "") {
      emailError.textContent = "Email is required";
      valid = false;
    }

    // 2. PASSWORD LOGIC:
    // We only block the submit if BOTH fields are empty.
    // If the Email is filled, we ALLOW the submit even if Password is empty.
    // This allows your server to check the database for the duplicate email.
    if (emailInput.value.trim() !== "" && passwordInput.value.trim() === "") {
        // Allow the submit to proceed to server to check for duplicate email
        valid = true; 
    } else if (emailInput.value.trim() === "" && passwordInput.value.trim() === "") {
        passwordError.textContent = "Password is required";
        valid = false;
    }

    if (!valid) {
      e.preventDefault(); // Stop only if truly invalid
    }
  });

  // Security: Clean history
  history.replaceState(null, "", "/admin/dashboard");
</script>

</body>
</html>