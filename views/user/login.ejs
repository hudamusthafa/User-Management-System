<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login</title>

  <!-- Font Awesome -->
  <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

  <link rel="stylesheet" href="/styles/userlogin.css">
</head>
<body>

<div class="container">
  <div class="signin">
    <h1>Login</h1>

    <!-- Backend message -->
    <% if (typeof message !== 'undefined') { %>
      <p class="msg error"><%= message %></p>
    <% } %>

    <!-- Client-side message -->
    <p id="clientMessage" class="msg"></p>

    <form method="post" action="/user/login" onsubmit="formValidate(event)">
      
      <input
        type="email"
        id="email"
        name="email"
        placeholder="email@gmail.com"
      >

      <div class="password-box">
        <input
          type="password"
          id="password"
          name="password"
          placeholder="Password"
        >
        <i class="fas fa-eye" onclick="togglePassword('password', this)"></i>
      </div>

      <button type="submit">Login</button>
    </form>
  </div>
</div>

<script>
  function showMessage(text) {
    const box = document.getElementById("clientMessage");
    box.textContent = text;
    box.className = "msg error";
  }

  function togglePassword(id, icon) {
    const input = document.getElementById(id);
    if (input.type === "password") {
      input.type = "text";
      icon.classList.replace("fa-eye", "fa-eye-slash");
    } else {
      input.type = "password";
      icon.classList.replace("fa-eye-slash", "fa-eye");
    }
  }

  function formValidate(e) {
    e.preventDefault();

    const email = document.getElementById("email").value.trim();
    const password = document.getElementById("password").value.trim();

    if (!email || !password) {
      showMessage("All fields are required");
      return;
    }

    e.target.submit();
  }
</script>

</body>
</html>
